Ryujinx shader translator: NVN2 constant bank 24 (fragment output colour transform).
The NVN2 compiler appends a 3x3 colour matrix (std140 rows, sometimes a vec3 at 0x30) to fragment shaders and reads it
from c[24], a bank the driver fills and the game never binds. Ryujinx sizes its bank table for the 18 Maxwell banks, so
GetConstantBufferBinding(24) threw IndexOutOfRangeException (227 FEFW fragment shaders). Bank 24 now takes slot 17's
binding (unused by NVN) under the name "<stage>_c24"; other out-of-range banks throw NotSupportedException. Applied at
build time by translator/Ryujinx.Graphics.Shader.csproj. The Ryujinx code in the context lines is MIT.
--- a/Translation/ResourceManager.cs
+++ b/Translation/ResourceManager.cs
@@ -145,14 +145,45 @@ namespace Ryujinx.Graphics.Shader.Translation
             return Properties.AddLocalMemory(new MemoryDefinition(name, type, arrayLength));
         }
 
+        // NVN2 (Ampere): the compiler appends an output colour transform to fragment shaders, a 3x3 matrix (std140 rows,
+        // sometimes a vec3 offset at 0x30) read from constant bank 24, which the driver supplies and the game never binds.
+        // Ryujinx only has the 18 Maxwell banks; bank 17 is unused by NVN (c0 driver, c1 data, c2 handles, c3..c16 uniform
+        // blocks 0..13), so bank 24 takes slot 17's binding. The buffer keeps the name "<stage>_c24" so the runtime knows it.
+        public const int NvnColorTransformBank = 24;
+        private const int NvnColorTransformSlot = 17;
+        private int _cbSlot17Bank = -1;
+
+        private int CbSlotToBank(int slot) => slot == NvnColorTransformSlot && _cbSlot17Bank >= 0 ? _cbSlot17Bank : slot;
+
         public int GetConstantBufferBinding(int slot)
         {
+            int bank = slot;
+            if (slot == NvnColorTransformBank)
+            {
+                slot = NvnColorTransformSlot;
+            }
+
+            if ((uint)slot >= (uint)_cbSlotToBindingMap.Length)
+            {
+                throw new NotSupportedException($"constant buffer bank {bank} is out of range");
+            }
+
+            if (slot == NvnColorTransformSlot)
+            {
+                if (_cbSlot17Bank >= 0 && _cbSlot17Bank != bank)
+                {
+                    throw new NotSupportedException("constant buffer banks 17 and 24 used together");
+                }
+
+                _cbSlot17Bank = bank;
+            }
+
             SetBindingPair setAndBinding = _cbSlotToBindingMap[slot];
             if (setAndBinding.Binding < 0)
             {
                 setAndBinding = _gpuAccessor.CreateConstantBufferBinding(slot);
                 _cbSlotToBindingMap[slot] = setAndBinding;
-                string slotNumber = slot.ToString(CultureInfo.InvariantCulture);
+                string slotNumber = bank.ToString(CultureInfo.InvariantCulture);
                 AddNewConstantBuffer(setAndBinding.SetIndex, setAndBinding.Binding, $"{_stagePrefix}_c{slotNumber}");
             }
 
